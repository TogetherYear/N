{
    "compilerOptions": {
        "target": "esnext",
        "module": "ESNext",
        "declaration": false,
        "experimentalDecorators": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "sourceMap": true,
        "rootDir": "Src",
        "baseUrl": "./",
        "paths": {
            "@/*": ["Src/*"]
        }
    },
    "include": ["Src/**/*.ts"],
    "ts-node": {
        "compilerOptions": {
            "module": "CommonJS"
        }
    }
}
